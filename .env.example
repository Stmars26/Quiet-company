# Required
ANTHROPIC_API_KEY=sk-ant-api03-your-key-here
FLASK_SECRET_KEY=generate-a-secure-random-string-here

# Production
FLASK_ENV=production

# Stripe Checkout URLs (replace test_ URLs with live ones when ready)
# STRIPE_BASIC_URL=https://buy.stripe.com/live_xxxxx
# STRIPE_PREMIUM_URL=https://buy.stripe.com/live_xxxxx
# STRIPE_ANNUAL_URL=https://buy.stripe.com/live_xxxxx

# Optional overrides
# QC_MODEL=claude-sonnet-4-20250514
# QC_RATE_LIMIT=60
# QC_MEMORY_DIR=memory_store
# PORT=5000

# ─── Publier (Social Media Automation) ────────────────────────────────────────
# Your app's public URL (required for Instagram image URLs)
# QC_BASE_URL=https://your-app.up.railway.app

# Twitter/X — Free tier at developer.x.com
# TWITTER_API_KEY=
# TWITTER_API_SECRET=
# TWITTER_ACCESS_TOKEN=
# TWITTER_ACCESS_SECRET=

# Instagram — Meta Graph API at developers.facebook.com
# INSTAGRAM_ACCESS_TOKEN=
# INSTAGRAM_USER_ID=

# Set timezone for scheduler (Railway env var)
# TZ=Europe/Amsterdam
